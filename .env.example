# Copie para .env (na raiz) para alterar as credenciais usadas pelo
# docker-compose.yml. Sem .env, o Compose usa estes mesmos valores padrão.
POSTGRES_USER=c216
POSTGRES_PASSWORD=c216
POSTGRES_DB=c216

# Portas publicadas no host
DB_PORT=5432
API_PORT=8000
FRONTEND_PORT=5173

# Origens liberadas no CORS da API (separadas por vírgula).
# Padrão: http://localhost:${FRONTEND_PORT}
# CORS_ORIGINS=http://localhost:5173
# URL da API usada pelo frontend (embutida no build).
# Padrão: http://localhost:${API_PORT}
# VITE_API_URL=http://localhost:8000
